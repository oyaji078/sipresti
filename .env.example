APP_NAME=SIPRESTI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Makassar

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sipresti
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Wajib true saat production (HTTPS)
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Identitas instansi
# ---------------------------------------------------------------------------
APP_INSTANSI="Puskesmas Lepak"
APP_SHORT_NAME=SIPRESTI
APP_LONG_NAME="Sistem Prediksi Risiko Stunting Balita"

# ---------------------------------------------------------------------------
# Machine Learning API (Vercel)
# ML_API_KEY harus sama persis dengan yang diset di Vercel.
# JANGAN commit nilai aslinya.
# ---------------------------------------------------------------------------
ML_API_URL=https://ml.domain-anda.id
ML_API_KEY=
ML_API_TIMEOUT=10

# ---------------------------------------------------------------------------
# Akun admin awal. Dipakai command: php artisan sipresti:create-admin
# Biarkan ADMIN_PASSWORD kosong agar password di-generate acak dan
# ditampilkan satu kali di terminal.
# ---------------------------------------------------------------------------
ADMIN_NAME="Administrator SIPRESTI"
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
